# Backend Environment Variables
# Copy this file to .env for local development

# Environment
NODE_ENV=development

# Server
PORT=5000

# Database
# Local: postgresql://user:password@localhost:5432/farewell_diary
# Production: Use your Render PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/farewell_diary

# Security Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-min-32-chars
ENCRYPTION_KEY=exactly-32-characters-required
JWT_SECRET=your-jwt-secret-min-32-characters

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Frontend URL (for CORS and OAuth redirects)
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# API Versioning
API_VERSION=v1

# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
